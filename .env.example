STATUS_VERSION=0.0.1
STATUS_IMAGE_REF=ghcr.io/OWNER/cake-status@sha256:REPLACE_WITH_RELEASE_DIGEST
STATUS_RELEASE_BASE_URL=https://github.com/OWNER/REPOSITORY/releases/download
STATUS_UPSTREAM_URL=https://cake.shmoza.net/api/v1/public/status
STATUS_ALLOW_HTTP_UPSTREAM=0
STATUS_HOME_URL=https://cake.shmoza.net/initialize/
STATUS_POLL_INTERVAL_SECONDS=30
STATUS_UPSTREAM_TIMEOUT_SECONDS=8
STATUS_ADMIN_TOKEN=replace-with-a-long-random-shared-secret
STATUS_VLESS_PROBE_TIMEOUT_SECONDS=12
STATUS_ALLOWED_HOSTS=statuscake.shmoza.net,localhost,127.0.0.1,::1
STATUS_VLESS_CANARY_FILE_PATH=./secrets/status-vless-canaries.json
STATUS_SECRET_GID=replace-with-cake-status-secret-group-id
STATUS_PORT=18082
